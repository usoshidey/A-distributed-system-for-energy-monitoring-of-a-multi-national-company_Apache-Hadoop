# Energy Monitoring System - Environment Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=supersecret-distributed-energy-key-2026
PORT=5000
DATABASE_URL=sqlite:///energy_monitoring.db

# Apache Hadoop Cluster Configuration
HADOOP_HOME=/usr/local/hadoop
HADOOP_NAMENODE_URI=hdfs://namenode:9000
HDFS_RAW_DATA_PATH=/energy-monitoring/raw-data
HDFS_PROCESSED_PATH=/energy-monitoring/processed-data
HDFS_REPORTS_PATH=/energy-monitoring/reports

# Apache Hive Configuration
HIVE_SERVER2_HOST=hive-server
HIVE_SERVER2_PORT=10000

